<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Activity reminders: restored after a reboot, and on time when the person allows exact alarms. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Optional alarm mode: rings with a system sound over the lock screen until stopped. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Automatic status by place (optional, asked for only when a place is saved). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Near">

        <!-- Restricted in Google Cloud to this package, its signing certificates and Maps SDK for Android. -->
        <meta-data android:name="com.google.android.geo.API_KEY" android:value="${MAPS_API_KEY}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Near"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="findme" android:host="auth" android:path="/confirmed" />
                <data android:path="/reset" />
            </intent-filter>
        </activity>

        <activity android:name=".widget.StatusWidgetConfigurationActivity"
            android:exported="true" android:theme="@style/Theme.Near">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".widget.ConnectionWidgetReceiver"
            android:exported="true" android:label="Near · Estado actual">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/connection_widget_info" />
        </receiver>

        <receiver android:name=".widget.PeopleWidgetReceiver"
            android:exported="true" android:label="Near · Tu gente">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/people_widget_info" />
        </receiver>

        <!-- Pushes from the send-push Edge Function (Firebase Cloud Messaging). -->
        <service android:name=".push.NearMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.ReminderSnoozeReceiver" android:exported="false" />
        <service android:name=".reminders.ReminderAlarmService" android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".reminders.ReminderAlarmActivity" android:exported="false"
            android:theme="@style/Theme.Near" android:launchMode="singleTask" android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- Replies typed in a message notification. Only Android delivers the PendingIntent. -->
        <receiver android:name=".push.MessageReplyReceiver" android:exported="false" />
        <!-- «Terminar ahora» from the notification shown after leaving the place of an activity early. -->
        <receiver android:name=".attendance.EndEarlyReceiver" android:exported="false" />
        <!-- Enter and exit of the saved places, delivered by Play services. -->
        <receiver android:name=".places.PlaceTransitionReceiver" android:exported="false" />
        <receiver android:name=".reminders.RemindersRescheduleReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
