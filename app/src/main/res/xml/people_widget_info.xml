<?xml version="1.0" encoding="utf-8"?>
<!-- "Near · Tu gente": 4×2 by default and resizable, so a taller widget lists more people. Low
     minResizeHeight for the same Xiaomi picker reason explained in connection_widget_info.xml. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="210dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:description="@string/people_widget_description"
    android:previewLayout="@layout/widget_people_preview"
    android:initialLayout="@layout/widget_people_preview"
    android:updatePeriodMillis="0"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
